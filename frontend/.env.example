# Frontend Environment Variables
# External API origin. Browser calls are proxied through same-origin /api by
# next.config.js so mobile browsers can retain the secure session cookie.
NEXT_PUBLIC_API_URL=https://topthreadz-d94j.vercel.app/api

# Vite alternative syntax compatibility (optional)
VITE_API_URL=https://topthreadz-d94j.vercel.app/api
