# Backend Environment Variables (Production & Development)
NODE_ENV=production

# Database (Neon / Supabase PostgreSQL URL with SSL mode)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server sessions are stored in PostgreSQL. Do not set authentication secrets in frontend variables.
# Legacy JWT variables are intentionally unused by the browser session flow.

# CORS & Domain Settings
CORS_ORIGIN=https://www.topthreadz.com.pk,https://topthreadz.com.pk
FRONTEND_URL=https://www.topthreadz.com.pk
BACKEND_PUBLIC_URL=https://topthreadz-d94j.vercel.app

# Gmail SMTP: enable Google 2-Step Verification and create an App Password.
# Never use the main Google password or expose these in frontend variables.
GMAIL_SMTP_USER=orders@your-domain.com
GMAIL_SMTP_APP_PASSWORD=your_16_character_google_app_password
SMTP_FROM="Top Threadz" <orders@your-domain.com>
EMAIL_LOGO_URL=https://www.topthreadz.com.pk/images/topthreadz-logo-light.png

# Cloudinary Storage (Free Persistent Product Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

MAX_FILE_SIZE=5242880

# Payment Gateway (Safepay)
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=sec_sandbox_key_here
SAFEPAY_WEBHOOK_SECRET=whsec_here
SAFEPAY_CURRENCY=PKR

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
# Persistent serverless rate limiting (recommended for production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Pakistan Regional Config
TAX_RATE=0.17
DELIVERY_CHARGE=200
FREE_DELIVERY_THRESHOLD=5000

# Account Security
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION=1800000
