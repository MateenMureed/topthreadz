# Backend Environment Variables (Production & Development)
NODE_ENV=production
PORT=5000

# Database (Neon / Supabase PostgreSQL URL with SSL mode)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS & Domain Settings
CORS_ORIGIN=https://your-store.vercel.app
FRONTEND_URL=https://your-store.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Cloudinary Storage (Free Persistent Product Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Local File Uploads (Fallback for development if Cloudinary is empty)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Payment Gateway (Safepay)
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=sec_sandbox_key_here
SAFEPAY_WEBHOOK_SECRET=whsec_here
SAFEPAY_CURRENCY=PKR

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Pakistan Regional Config
TAX_RATE=0.17
DELIVERY_CHARGE=200
FREE_DELIVERY_THRESHOLD=5000

# Account Security
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION=1800000
