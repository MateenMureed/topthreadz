# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render Web Service)
# ==========================================
NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection (Neon / Supabase)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secrets (Generate random 32+ char strings)
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS & Domain Configuration
CORS_ORIGIN=https://your-store.vercel.app
FRONTEND_URL=https://your-store.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Cloudinary Integration (Free Tier for Image Hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Safepay Payment Gateway Config
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=sec_sandbox_key_here
SAFEPAY_WEBHOOK_SECRET=whsec_here
SAFEPAY_CURRENCY=PKR

# Upload & Rate Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Pakistan eCommerce Settings
TAX_RATE=0.17
DELIVERY_CHARGE=200
FREE_DELIVERY_THRESHOLD=5000

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==========================================
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api
